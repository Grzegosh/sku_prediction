noise = trend_df_wo_weekly_profile['rev_div_rev_7d_wo_w_index'].dropna()

noise_mean = noise.mean()
noise_std = noise.std()
noise_skew = noise.skew()
noise_kurt = noise.kurt()

print(f"mean={noise_mean:.4f}  std={noise_std:.4f}  skew={noise_skew:.3f}  kurt={noise_kurt:.3f}")

plt.figure(figsize=(12, 8))
ax = sns.histplot(noise, bins=50, kde=True)
ax.axvline(noise_mean, c='black', linestyle='-', label=f"Mean = {noise_mean:.3f}")
ax.axvline(noise_mean - 2 * noise_std, c='black', linestyle='--', label=f"-2 std = {noise_mean - 2 * noise_std:.3f}")
ax.axvline(noise_mean + 2 * noise_std, c='black', linestyle='--', label=f"+2 std = {noise_mean + 2 * noise_std:.3f}")
plt.legend()
plt.title(f"Distribution of the cleaned ratio (skew = {noise_skew:.2f}, kurtosis = {noise_kurt:.2f})")
plt.xlabel("Revenue / 7-day average / weekday index")
plt.ylabel("Number of days")





upper_bound = noise_mean + 2 * noise_std
lower_bound = noise_mean - 2 * noise_std


cols_to_pick = ['date','month','iso_day_of_week', 'year', 'is_holiday', 'is_special_day','is_payday_window','is_discount_period','revenue',
                                                'rev_div_rev_7d', 'rev_div_rev_7d_wo_w_index']
upper_bound_mask = noise > upper_bound
upper_bound_mask = noise[upper_bound_mask].index
upper_outlier_days = trend_df_wo_weekly_profile[cols_to_pick].loc[upper_bound_mask]
upper_outlier_days['direction'] = 'upper'


lower_bound_mask = noise < lower_bound
lower_bound_mask = noise[lower_bound_mask].index
lower_outlier_days = trend_df_wo_weekly_profile[cols_to_pick].loc[lower_bound_mask]
lower_outlier_days['direction'] = 'lower'


outlier_days = pd.concat([upper_outlier_days, lower_outlier_days])
outlier_days['num_of_std'] = np.abs((outlier_days['rev_div_rev_7d_wo_w_index'] - noise_mean) / noise_std)
outlier_days = outlier_days.sort_values('num_of_std', ascending=False)

outlier_days['date_dt'] = pd.to_datetime(outlier_days['date'])





outlier_days['direction'].value_counts()


outlier_days[outlier_days['date_dt'].dt.day <= 12].shape[0] / outlier_days.shape[0] * 100


cross_monthly = pd.crosstab(
    outlier_days['month'],
    outlier_days['direction']
)

denom_monthly = trend_df_wo_weekly_profile.copy()
denom_monthly = denom_monthly.dropna(subset='rev_div_rev_7d')
all_days = denom_monthly.shape[0]
denom_monthly = denom_monthly.groupby(
    'month'
).size()

cross_monthly = cross_monthly.div(denom_monthly, axis=0) * 100
ref = outlier_days.shape[0] / all_days * 100 


plt.figure(figsize=(12,8));
ax = cross_monthly.plot(kind='bar', stacked=True);
ax.axhline(ref);






cross_weekly = pd.crosstab(
